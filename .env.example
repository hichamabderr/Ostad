

# Supabase public client configuration.
# Use the publishable key only in browser/server application code.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Optional canonical URL used for OAuth callbacks in deployed environments.
# Example: https://ostady.netlify.app
NEXT_PUBLIC_APP_URL="https://YOUR_SITE.netlify.app"

# Server-only secret. Never expose this through NEXT_PUBLIC_* or client components.
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
